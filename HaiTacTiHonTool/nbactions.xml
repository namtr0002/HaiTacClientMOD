<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-Xms512m -Xmx2048m -XX:+UseG1GC -Dsun.java2d.uiScale=1.0</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath com.deplor.haitactihontool.ui.Bootstrap</exec.args>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.deplor.haitactihontool.ui.Bootstrap</exec.mainClass>
            <exec.executable>java</exec.executable>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address} -Xms512m -Xmx2048m -XX:+UseG1GC -Dsun.java2d.uiScale=1.0</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath com.deplor.haitactihontool.ui.Bootstrap</exec.args>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.deplor.haitactihontool.ui.Bootstrap</exec.mainClass>
            <exec.executable>java</exec.executable>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-Xms512m -Xmx2048m -XX:+UseG1GC -Dsun.java2d.uiScale=1.0</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath com.deplor.haitactihontool.ui.Bootstrap</exec.args>
            <exec.mainClass>com.deplor.haitactihontool.ui.Bootstrap</exec.mainClass>
            <exec.executable>java</exec.executable>
        </properties>
    </action>
</actions>
